<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>co.uk.androidalliance.plugin.dpad</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>D-Pad (Directional Pad UI Addon)</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.androidalliance.co.uk">George Medve (Android Alliance)</vendor>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Notification group for logging -->
        <notificationGroup displayType="NONE" id="Dpad (Logging)" isLogByDefault="true"/>
        <!-- Notification group for errors -->
        <notificationGroup displayType="BALLOON" id="Dpad (Errors)" isLogByDefault="true"/>
    </extensions>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description>
        <![CDATA[
            A Directional Pad UI addon for Android Studio.<br />
            There are two basic ways to invoke a command:
        <ul>
            <li>Through the View->Tool Windows->Directional Pad menu</li>
            <li>By searching the icon amongst the tools in the application frame, normally on the right.</li>
        </ul>
        ]]>
    </description>

    <!-- Compatibility range.
         `since-build` is the oldest supported IDE branch (2024.3 / 243).
         `until-build` is intentionally omitted so the plugin remains installable on
         current *and* future Android Studio / IntelliJ IDEA releases.
         These values are patched at build time from `pluginSinceBuild` / `pluginUntilBuild`
         in gradle.properties (see the `patchPluginXml` configuration in build.gradle.kts).
         Read more: https://plugins.jetbrains.com/docs/intellij/build-number-ranges.html -->
    <idea-version since-build="243"/>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Required: the plugin talks to devices/emulators through ddmlib + AdbService,
         which are supplied by the Android plugin. Bundled in Android Studio and
         installable in IntelliJ IDEA (Community & Ultimate). -->
    <depends>org.jetbrains.android</depends>

    <!-- Optional: only used to advertise K2 compatibility. The plugin contains no
         Kotlin PSI code, so it still loads in IDEs without the Kotlin plugin. -->
    <depends optional="true" config-file="dpad-kotlin.xml">org.jetbrains.kotlin</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">

        <!-- Position (right, left, bottom) -->
        <toolWindow
                id="Directional Pad"
                anchor="right"
                factoryClass="uk.co.androidalliance.dpad.DPadToolWindowFactory"
                icon="/icons/dpad_13px.svg"/>
    </extensions>

    <actions>
    </actions>

</idea-plugin>